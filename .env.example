# OpenAI API Key
# SophNet 用户：填 sophnet 控制台的 API Key（下方 OPENAI_BASE_URL 已按 SophNet OpenAI
# 兼容端点配置，chat 走 https://.../api/open-apis/v1/chat/completions）
OPENAI_API_KEY=sk-xxx

# API 代理地址（可选，默认为 OpenAI 官方地址）
# SophNet OpenAI 兼容端点（标准 /v1/chat/completions 格式，SDK 直接可用）
OPENAI_BASE_URL=https://www.sophnet.com/api/open-apis/v1

# 模型配置
MODEL_NAME=DeepSeek-V4-Flash-0731
TEMPERATURE=0.7

# MCP 配置（第4期）
MCP_ENABLED=false
MCP_SERVER_URL=http://127.0.0.1:9123/mcp

# ReAct 循环与上下文水位（推理模型适配 T2/T8）
# 单轮墙钟预算：推理模型单调用 30–60s，8 步会撞旧的 120s → 抬到 300s；
# 待 T0 实测 P95 后按 max_react_steps × P95 < TURN_BUDGET_SECONDS 校准
TURN_BUDGET_SECONDS=300
MAX_REACT_STEPS=8
# 输出预留（20% × 窗口）必须 ≥ LLM_MAX_TOKENS，故窗口随输出上限抬到 65536
# （32768 × 20% ≈ 6.5k < 8192 会失衡）；改任一侧都要同步另一侧
CONTEXT_WINDOW_TOKENS=65536

# Memory 配置（第7期）
MEMORY_ENABLED=true
MEMORY_DIR=app/sessions/memory
MEMORY_USER_ID=default
MAX_LTM_FACTS=50

# 记忆系统重构（2026-09-15）：混合检索/嵌入/清理 sweep（默认全关=现状）
# 语义+词面双路融合检索总开关；开启前确保嵌入服务可用（复用 EMBEDDING_* 提供方配置）
MEMORY_SEMANTIC_ENABLED=false
# 记忆嵌入模型（空=跟随 EMBEDDING_MODEL；非空透传嵌入器，存储标签与向量来源一致）
MEMORY_EMBEDDING_MODEL=
# 融合打分：score = w_lex·dice + w_sem·cosine + 类别权重 + 新近度
MEMORY_SEMANTIC_WEIGHT=0.6
MEMORY_LEXICAL_WEIGHT=0.4
# 语义路门槛：词面零重叠时融合相关性 ≥ 该值才入选（阶段4 消融调节）
MEMORY_FUSION_THRESHOLD=0.25
# 巩固清理 sweep（legacy 键规范化 + 语义重复簇合并；默认关，观察期手动触发）
MEMORY_SWEEP_ENABLED=false
MEMORY_SWEEP_ACTIVE_THRESHOLD=40
MEMORY_SWEEP_MAX_CLUSTERS=10
MEMORY_SWEEP_SIMILARITY=0.92
# 阶段4 消融候选：memory 上下文份额（默认 0.10，候选 0.15；消融不过回退）
MEMORY_BUDGET_SHARE=0.10

# Skill 配置（第8期）
SKILLS_ENABLED=true
SKILLS_DIR=app/agent/skills/definitions

# Evaluation 配置（第9期，离线评估工具）
EVAL_DATASET_PATH=app/evaluation/cases.json
EVAL_USE_JUDGE=true
EVAL_PASS_THRESHOLD=0.6

# RAG 配置（第5期）
# EMBEDDING_MODEL 在下方「Embedding 提供方」块统一配置
KB_DIR=app/agent/rag/knowledge
# 向量后端：numpy（手写余弦，教学透明）/ chroma（向量数据库，生产代表）
RAG_BACKEND=numpy
# NumpyBackend 索引文件
KB_INDEX_PATH=app/sessions/kb_index.json
# ChromaBackend 持久化目录 + collection
CHROMA_PERSIST_DIR=app/sessions/chroma
CHROMA_COLLECTION=ecom_kb

# Embedding 提供方：openai（默认，走 OPENAI_BASE_URL 的标准 /embeddings）
#   sophnet = SophNet EasyLLM（如 bge-m3，非 OpenAI 兼容格式，请求体 input_texts/easyllm_id）
# 用 sophnet 时 EMBEDDING_MODEL 需同步改为实际模型名（如 bge-m3）
EMBEDDING_PROVIDER=sophnet
EMBEDDING_MODEL=bge-m3
# SophNet 配置（EMBEDDING_PROVIDER=sophnet 时 URL/EASYLLM_ID 必填）
SOPHNET_EMBEDDING_URL=
# 示例：https://www.sophnet.com/api/open-apis/projects/{projectId}/easyllms/embeddings
SOPHNET_API_KEY=
SOPHNET_EASYLLM_ID=
SOPHNET_EMBEDDING_DIMENSIONS=1024

# RAG 生产化（阶段七）
# 混合检索：向量 + BM25 + RRF（补精确术语盲区）
RAG_HYBRID=false
RAG_HYBRID_RECALL_K=30
# 精排器：none 不启用；取值见「阶段七」块的 RAG_RERANK（只在一处定义）
RAG_RERANK=bge-reranker-v2-m3
# 检索质量评估集（recall@k / MRR / nDCG 回归门禁）
RETRIEVAL_EVAL_DATASET_PATH=app/evaluation/retrieval_cases_v3.json
# 相关度阈值必须针对完整检索配置校准；未配置表示不做低相关结果过滤
# RAG_MIN_RELEVANCE_SCORE=0.42
# 检索 hard 侧工作流 A：query 表层规范化（同音错字/拼音缩写还原为词表规范词）。
# 词表由 app/scripts/build_query_lexicon.py 构建期生成（pypinyin/jieba 仅构建期
# 依赖，运行时零依赖）；词表缺失/损坏时恒等返回并打点（fail-open）。
RAG_QUERY_NORMALIZE=false
RAG_QUERY_NORMALIZE_LEXICON_PATH=app/agent/rag/query_lexicon.json

# RAG 切分优化（2026-09 方案 P0）：检索块/生成块分离 + 前缀去重
# 关闭即回到旧装配（父块=命中位置附近的章节窗口、前缀展示完整标题路径）；
# 改动这些开关必须重建索引（已纳入配置指纹，health 会提示重建）
RAG_PARENT_MERGE=true
RAG_GEN_UNIT_TARGET_CHARS=1800
RAG_MAX_PARENT_CHARS=4000
RAG_PREFIX_DEDUP=true

# RAG 构建期上下文增强（P1-1 Contextual Retrieval，opt-in）
# 开启后构建期调用 chat 模型为每块生成定位上下文（只进 embedding/BM25 输入，
# 证据文本不变）；改 RAG_CONTEXTUAL_PROMPT_VERSION 会失效缓存并进配置指纹
RAG_CONTEXTUAL_INDEX=false
# RAG_CONTEXTUAL_MODEL=gpt-4o-mini
RAG_CONTEXTUAL_PROMPT_VERSION=v1
RAG_CONTEXTUAL_MAX_CHARS=80

# PDF 解析（P1-3）：首选 Docling（未安装/解析失败自动回退 pdfplumber+pypdf）
RAG_PDF_DOCLING=true
RAG_PDF_REPEATED_LINE_RATIO=0.6
RAG_PDF_REPEATED_LINE_MIN_PAGES=3

# Evolution 配置（第10期，QA 自动沉淀）
EVOLVE_CAPTURE_ENABLED=true
SELF_EVOLVE_ENABLED=false
# 人工客服问答沉淀（人工知识支路）：resolve 勾选 knowledge_candidate 的工单
# → Evolution 导入 pending → 审核后台批准 → 现有发布事务。首次部署 false；
# 开启后只采集显式勾选的工单，不扫描历史 resolution；回滚只需关闭本开关
#（Redis 待处理事件与 ledger pending 保留，不丢数据）
HUMAN_QA_EVOLUTION_ENABLED=false
EVOLVE_TURNS_DIR=app/sessions/evolution/turns
EVOLVE_STATE_DIR=app/sessions/evolution/state
EVOLVE_OUTPUT_DIR=app/sessions/evolution/output
EVOLVE_MIN_CONFIDENCE=0.8
EVOLVE_MIN_QUALITY=0.8
EVOLVE_PRE_DEDUP_THRESHOLD=0.95
EVOLVE_DEDUP_THRESHOLD=0.9
EVOLVE_MAX_JUDGE_PER_RUN=50
EVOLVE_MAX_PER_RUN=20
EVOLVE_PENDING_AGING_DAYS=30
EVOLVE_TURN_RETENTION_DAYS=90
EVOLVE_LOCK_STALE_SECONDS=7200
EVOLVE_EFFECTIVE_DAYS=180
EVOLVE_MAX_REGROUND_PER_RUN=20
EVOLVE_REVALIDATE_ENABLED=true
KB_GENERATION_PATH=app/sessions/kb_generations.json

# ============================================================
# 阶段二：状态外置（会话/记忆/锁 → Redis；连不上自动降级本地文件）
# ============================================================
# 存储后端（0.3.0 起生效；安全修复 P2）：
#   auto  = 历史行为：db_url > Redis(可用) > 文件
#   file  = 显式落本地文件（Redis 仅保留锁/限流角色）
#   redis = 强制 Redis（不可用且 REDIS_REQUIRED=false → 降级文件并告警）
SESSION_STORE_BACKEND=auto
REDIS_URL=redis://localhost:6379/0
# 生产部署必须 true：Redis 连不上则启动 fail-fast（2.7）
REDIS_REQUIRED=false
# 会话锁 TTL（≥ 单轮最长耗时；lease 自动续期）
SESSION_LOCK_TTL_SECONDS=300
# 长期记忆：每 N 轮增量巩固（close() 在 K8s 不可靠）+ 静默兜底 job
MEMORY_CONSOLIDATE_EVERY=10
MEMORY_CONSOLIDATE_IDLE_MINUTES=30
MEMORY_CONSOLIDATE_SCAN_MINUTES=5
# evolution turns 归档对象存储（local | s3）
TURNS_ARCHIVE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=

# ============================================================
# 服务端（阶段一 1.7：Agent 执行线程池上限）
# ============================================================
SERVER_AGENT_THREADS=32

# ============================================================
# 阶段三：鉴权与安全（生产必配）
# ============================================================
# true：Bearer JWT 校验，user_id 从 token 解出（请求体 user_id 被忽略）
AUTH_ENABLED=false
# K8s Secret 注入；留空仅开发
JWT_SECRET=
JWT_ISSUER=ecom-agent
JWT_AUDIENCE=ecom-agent-api
JWT_TTL_MINUTES=1440
# 运行时 guardrails：输入注入/PII、输出敏感词（命中降级话术转人工）
GUARDRAILS_ENABLED=true
GUARDRAIL_BLOCK_TERMS=
# 业务范围闸门：true 时非业务/闲聊内容以固定引导话术拦截（不含业务词的问题走 LLM 判定，失败拒答）
BUSINESS_ONLY_SCOPE=false
# 检索内容来源围栏（KB 块视为不可信数据；KB 投毒样本拦截）
RETRIEVAL_FENCE_ENABLED=true
# 工具级授权：订单归属校验（越权 403 语义；0.3.0 起无身份调用 fail-closed 拒绝）
ENFORCE_ORDER_OWNERSHIP=false
# 用户级限流与配额（3.7；0=不限）
RATE_LIMIT_RPS=5
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_DAILY_TOKENS=0
# 运营端点（/v1/handoffs*、/v1/messages/search）单独强制 JWT+ops scope
# （auth 关闭也可收紧运营面；签发工具：python -m app.scripts.issue_token）
OPS_RBAC_REQUIRED=false
# MCP 认证头（3.4；配置后 MCP server 拒绝匿名请求，两侧同 token）
MCP_AUTH_TOKEN=
# MCP 工具调用的操作者身份（归属校验 fail-closed 的比对主体）
MCP_ACTOR_USER_ID=mcp-actor
# 知识审核后台管理令牌（安全修复 P1；留空 → 后台整站 503 fail-closed）
REVIEW_ADMIN_TOKEN=
# TLS 部署置 true：审核后台会话 cookie 加 Secure 位
REVIEW_ADMIN_COOKIE_SECURE=false

# ============================================================
# 阶段四：可观测性 + LLM 调用治理
# ============================================================
# json（生产，stdout 结构化）| console（CLI 可读）
LOG_FORMAT=json
# OTLP HTTP 端点（空=不导出，埋点空跑）
OTEL_EXPORTER_ENDPOINT=
OTEL_SERVICE_NAME=ecom-agent
# LLM 韧性客户端（推理模型适配 T1/T2/T7/T8 重新定参）
# 显式 timeout：推理模型单调用常超 60s（思考 token 计入同一次响应）；待 T0 实测 P95 校准
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_MAX_CONCURRENT=16
LLM_FALLBACK_MODEL=
# 输出上限：推理模型的思考 token 与可见输出共享该上限（2048 会被思考吃光）
LLM_MAX_TOKENS=8192
# 便宜模型：结构化提取/STM/摘要/路由/构建期上下文（解决每轮双 LLM 调用成本）
# 推理模型适配 T1：**换推理主模型前必须配置**——不配则这些辅助调用全部跟着进推理
# 模型（又贵又慢，且 temperature 冲突面扩大）；配一个非推理廉价模型即可整体摘离
EXTRACTION_MODEL=deepseek-flash
# 模型画像覆写（T1）：JSON「模型名前缀 → 画像字段子集」，T0 探针输出直接灌入，免发版。
# 部署覆写优先于内置 registry；空 = 只用内置画像（旧模型未命中画像 = 现有行为逐字节不变）
# 例：{"deepseek-reasoner":{"supports_forced_tool_choice":false}}
# 生成：python -m app.scripts.probe_model_capability --model <name> --emit-overrides
MODEL_PROFILE_OVERRIDES=
# SSE 透出模型推理原文（T6）：**默认关**。开启是对「只透出受控状态说明、不透出模型
# 原始思考」这一有意设计的反向修改，属产品/合规决策（透出侧已过输出 guardrails，
# 长度有界）；关闭不影响审计——reasoning 始终进 turns archive（T3）
SSE_REASONING_ENABLED=false


# ============================================================
# 阶段七：检索精排 / 知识时效
# ============================================================
# 精排器取值（RAG_RERANK）在上方「检索」块定义，此处不重复
# 自部署 TEI（compose 服务 reranker：宿主 8001 → 容器 80；集群内用 http://reranker:80/rerank）
RERANK_ENDPOINT_URL=http://localhost:8001/rerank
RERANK_API_KEY=
RERANK_MODEL=
# 知识时效：effective_date 超期标注天数（6.4）
KNOWLEDGE_AGING_DAYS=365

# ============================================================
# 阶段八：MySQL 正本 + ES 检索（Redis 保留：锁/限流/会话热缓存）
# ============================================================
# 正本连接串；空=沿用文件/Redis 存储（开发默认）。
# 生产：mysql+pymysql://user:pwd@localhost:3306/ecom?charset=utf8mb4
# 本地无 MySQL：sqlite:///app/sessions/ecom.sqlite（同为行式追加正本）
DB_URL=
# 会话热缓存 TTL（write-through，Redis 可用时生效）
SESSION_HOT_CACHE_TTL_SECONDS=1800
# 消息入库同事务写出箱 → ES 对话全文检索（可重建）
MESSAGE_INDEX_OUTBOX_ENABLED=true
# ES 检索：KB 混合检索(alias 版本化) + 对话全文；空=不启用（numpy/chroma 照旧）
ES_URL=
ES_USER=
ES_PASSWORD=
ES_INDEX_PREFIX=ecom

# ---- KB 文档上传（分片断点续传 + MySQL 元数据 + 版本化重建入库） ----
# 总开关（服务未启用时端点返回 503）
KB_UPLOAD_ENABLED=true
# 部署期锁后端：auto（方言 mysql→MySQL GET_LOCK；否则 Redis→Redis 租约；双不可用→报错）
# | mysql | redis | file（file 仅显式配置，单机开发）。*** 选择按配置/方言固定，
# 运行时不降级 —— 多 Pod 在任何故障时序下锁定同一锁域 ***
KB_WRITE_LOCK_BACKEND=auto
APP_ENV=dev
# 分片存储：local（单 Pod 或共享卷）| s3（对象存储，跨 Pod 共享）
KB_UPLOAD_STORAGE=local
KB_UPLOAD_TMP_DIR=app/sessions/uploads
# 以下三个目录必须与知识库同挂载点（原子 rename 的前提；多 Pod 需共享卷）
KB_UPLOAD_STAGING_DIR=app/agent/rag/knowledge/.staging
KB_UPLOADS_DIR=app/agent/rag/knowledge/uploads
KB_UPLOAD_TRASH_DIR=app/agent/rag/knowledge/.trash
KB_UPLOAD_ORIGINAL_DIR=app/sessions/upload_originals
# 限额（防解析炸弹/海量分片）
KB_UPLOAD_MAX_BYTES=20971520
KB_UPLOAD_CHUNK_SIZE=1048576
KB_UPLOAD_MIN_CHUNK_SIZE=65536
KB_UPLOAD_MAX_CHUNK_SIZE=4194304
KB_UPLOAD_MAX_CHUNKS=1000
KB_UPLOAD_MAX_PAGES=200
KB_UPLOAD_MAX_ZIP_ENTRIES=2000
KB_UPLOAD_MAX_ZIP_BYTES=52428800
KB_UPLOAD_MAX_ZIP_RATIO=200
KB_UPLOAD_MAX_TEXT_CHARS=200000
KB_UPLOAD_PARSE_TIMEOUT=30
KB_UPLOAD_PUBLISH_TIMEOUT=60
KB_UPLOAD_SESSION_TTL=604800
# 保留期（GC；indexed 原件永留）
KB_UPLOAD_RETENTION_ORIGINAL_DAYS=90
KB_UPLOAD_RETENTION_TRASH_DAYS=30
KB_UPLOAD_RETENTION_FAILED_DAYS=30
KB_GC_INTERVAL_SECONDS=21600
KB_GC_MAX_ITEMS=100
KB_GC_OPPORTUNISTIC_MAX=10

# ---- KB 异步建库（多实例异步改造；迁移 007：kb_index_jobs 任务队列）----
# 两阶段上线：默认 false（同步语义）；生产置 kb_control.kb_async_enabled=1
# （共享开关，运行时生效）一次性启用异步 API 与 Worker
KB_ASYNC_API=false
KB_ASYNC_CONTROL_KEY=kb_async_enabled
# KB Worker（仅独立 Worker Deployment 置 true；Web Pod 不启动）
KB_WORKER_ENABLED=false
KB_WORKER_CONCURRENCY=1
KB_JOB_LEASE_SECONDS=120
KB_JOB_HEARTBEAT_SECONDS=30
KB_JOB_POLL_SECONDS=2
KB_JOB_MAX_ATTEMPTS=5
KB_JOB_BACKOFF_BASE_SECONDS=5
KB_JOB_BACKOFF_MAX_SECONDS=300
KB_JOB_LOCK_WAIT_SECONDS=2
KB_WORKER_GRACE_SECONDS=120
KB_JOB_BACKLOG_ALERT_SECONDS=600
KB_JOB_RETENTION_DONE_DAYS=90
KB_JOB_RETENTION_FAILED_DAYS=180
